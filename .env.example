# LLDAP on Railway — environment variables
#
# Copy to .env only for local testing; on Railway these are service
# variables. Values marked GENERATED are filled by the one-click
# deploy form (${{secret(32)}} / ${{RAILWAY_PUBLIC_DOMAIN}}).

# --- Deploy-form variables (generated per deploy) --------------------
LLDAP_LDAP_USER_PASS=GENERATED_32_CHAR_SECRET
LLDAP_JWT_SECRET=GENERATED_32_CHAR_SECRET
LLDAP_KEY_SEED=GENERATED_32_CHAR_SECRET

# --- Derived at boot by the wrapper entrypoint ------------------------
# LLDAP_HTTP_URL=https://$RAILWAY_PUBLIC_DOMAIN (only when a domain
# exists; never set it to https://${{RAILWAY_PUBLIC_DOMAIN}} as a
# variable — it resolves to a bare "https://" on first deploy and
# LLDAP rejects it hard with "empty host", crash-looping the
# container. Found in e2e 2026-11-08.)

# --- Baked into the image (Dockerfile ENV) ---------------------------
# LLDAP_LDAP_BASE_DN=dc=example,dc=com
# LLDAP_LDAP_USER_EMAIL=admin@example.com
# LLDAP_LDAP_PORT=3890
# LLDAP_DATABASE_URL=sqlite:///data/users.db?mode=rwc

# --- Set at boot by the wrapper entrypoint ---------------------------
# LLDAP_HTTP_PORT=$PORT  (Railway-injected; upstream default 17170)

# --- Optional upstream variables (unset by default) ------------------
# LLDAP_LDAP_USER_DN=admin            # Admin username (default admin)
# LLDAP_VERBOSE=false                 # Verbose logging
# LLDAP_SMTP_OPTIONS__ENABLE_PASSWORD_RESET=true
# LLDAP_SMTP_OPTIONS__SERVER=smtp.example.com
# LLDAP_SMTP_OPTIONS__PORT=587
# LLDAP_SMTP_OPTIONS__SMTP_ENCRYPTION=STARTTLS
# LLDAP_SMTP_OPTIONS__USER=sender@example.com
# LLDAP_SMTP_OPTIONS__PASSWORD=your-smtp-password
# LLDAP_SMTP_OPTIONS__FROM=LLDAP Admin <sender@example.com>
# LLDAP_LDAPS_OPTIONS__ENABLED=true   # LDAPS (needs cert files on /data)
# LLDAP_LDAPS_OPTIONS__PORT=6360
# LLDAP_LDAPS_OPTIONS__CERT_FILE=/data/cert.pem
# LLDAP_LDAPS_OPTIONS__KEY_FILE=/data/key.pem
